# SecureReview AI configuration example.
# These are ordinary environment variables (the app does not read this file by itself).
# Copy the lines you need into your shell, for example:  export SECUREREVIEW_REAL=1
# Never put a Snyk token in this file or in the repository. Sign in with: snyk auth

# 1 = run the real Snyk Code and Semgrep. Anything else (or unset) = mock adapters, demo mode.
SECUREREVIEW_REAL=0

# Semgrep rules. "auto" downloads rules (needs internet). For offline use point at a local
# clone of github.com/semgrep/semgrep-rules, e.g. ../semgrep-rules/java (commit a5ad1714 used in the study)
SEMGREP_CONFIG=auto

# Seconds allowed per sample for each tool before the result is recorded as Error
SEMGREP_TIMEOUT=120
SNYK_TIMEOUT=180
